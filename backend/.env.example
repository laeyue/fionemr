PORT=5000
# Required: pooled Neon connection for app requests, including local development.
DATABASE_URL=
# Direct Neon connection for migrations.
DATABASE_URL_UNPOOLED=
# Optional: separate disposable Neon test database; never use the app database.
TEST_DATABASE_URL=
EMAIL_MODE=simulate
BACKEND_URL=http://localhost:5000
PG_POOL_SIZE=1
CLINIC_BED_CAPACITY=5
CLINIC_TIME_ZONE=Asia/Singapore
CORS_ORIGIN=

# EMAIL_MODE=simulate sends nothing. Set EMAIL_MODE=brevo for HTTPS API delivery after verifying the key and sender.
# Brevo API mode requires BREVO_API_KEY and a verified SENDER_EMAIL.
# SMTP mode requires SMTP_USER, SMTP_PASS (an SMTP key), and SENDER_EMAIL.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=OLPHA AeroHealth Clinic
